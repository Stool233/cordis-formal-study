{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Stool233/cordis-formal-study/blob/main/schemas/ordinary-gates-report.schema.json",
  "title": "Cordis Formal Study Ordinary Gates Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "stage", "status", "formalStatus", "formalEvidence", "repositories"],
  "properties": {
    "schema": { "const": "cordis.formal-study-ordinary-gates/v1" },
    "stage": { "const": "upstream-fix" },
    "status": { "const": "pass" },
    "formalStatus": { "const": "not-run" },
    "formalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "cordis", "deepseekHarness"],
      "properties": {
        "stage": { "const": "conformance" },
        "cordis": { "$ref": "#/$defs/evidence" },
        "deepseekHarness": { "$ref": "#/$defs/evidence" }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cordis", "deepseekHarness"],
      "properties": {
        "cordis": { "$ref": "#/$defs/repository" },
        "deepseekHarness": { "$ref": "#/$defs/repository" }
      }
    }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reference": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/).+$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "report"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "report": { "$ref": "#/$defs/reference" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "status": { "const": "pass" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "instrumentation", "commands"],
      "properties": {
        "revision": { "$ref": "#/$defs/revision" },
        "instrumentation": { "const": "absent" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        }
      }
    }
  }
}
